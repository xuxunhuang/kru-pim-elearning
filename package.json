                            "sharp":  "0.35.3",
                            "tailwindcss":  "4.2.1",
                            "typescript":  "5.9.3",
                            "vinext":  "0.0.50",
                            "vite":  "8.0.13",
                            "wrangler":  "4.92.0"
                        }
}