                         "react":  "19.2.6",
                         "react-dom":  "19.2.6"
                     },
    "devDependencies":  {
                            "@cloudflare/vite-plugin":  "1.37.1",
                            "@cloudflare/workers-types":  "^5.20260801.1",
                            "@tailwindcss/postcss":  "4.2.1",
                            "@types/node":  "22.19.19",
                            "@types/react":  "19.2.14",
                            "@types/react-dom":  "19.2.3",
                            "@vitejs/plugin-react":  "6.0.2",
                            "@vitejs/plugin-rsc":  "0.5.26",
                            "drizzle-kit":  "0.31.10",
                            "eslint":  "9.39.4",
                            "eslint-config-next":  "16.2.11",
                            "postcss":  "8.5.25",
