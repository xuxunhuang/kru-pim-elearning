{
    "name":  "kru-pim-elearning",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=22.13.0"
                },
    "scripts":  {
                    "dev":  "vinext dev",
                    "build":  "vinext build",
                    "start":  "vinext start",
                    "lint":  "eslint .",
                    "typecheck":  "tsc --noEmit",
                    "audit":  "pnpm audit --prod --audit-level high",
                    "db:generate":  "drizzle-kit generate",
                    "deploy:production":  "powershell -ExecutionPolicy Bypass -File scripts/deploy-cloudflare.ps1",
                    "test":  "node --experimental-strip-types --test tests/*.test.ts",
                    "smoke":  "powershell -ExecutionPolicy Bypass -File scripts/smoke-check.ps1",
                    "db:backup":  "powershell -ExecutionPolicy Bypass -File scripts/d1-backup.ps1",
                    "db:restore:local":  "powershell -ExecutionPolicy Bypass -File scripts/d1-restore.ps1"
                },
    "dependencies":  {
                         "drizzle-orm":  "0.45.2",
                         "next":  "16.2.11",
